# Budget Buddy Environment Variables

# Application
NEXT_PUBLIC_APP_NAME="Budget Buddy"
NEXT_PUBLIC_VERSION="1.0.0"

# API
NEXT_PUBLIC_API_URL="http://localhost:3000/api"

# Features
NEXT_PUBLIC_ENABLE_VOICE_INPUT=true
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_LOCAL_STORAGE=true

# NLP Settings
NLP_CONFIDENCE_THRESHOLD=0.5
NLP_LANGUAGE="he-IL"

# Claude AI - LifeBalance
# עבור עוזר AI חכם
# קבל API key מ: https://console.anthropic.com/account/keys
ANTHROPIC_API_KEY=your_api_key_here

# Note: לפרודקשן, שמור את ה-key ב-environment variables בלבד!
# אל תכניס את ה-key ישירות לקוד
