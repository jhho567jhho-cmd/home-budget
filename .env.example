# LifeBalance Environment Variables

# Application
NEXT_PUBLIC_APP_NAME="LifeBalance"
NEXT_PUBLIC_VERSION="1.0.0"

# API
NEXT_PUBLIC_API_URL="http://localhost:3000/api"

# Features
NEXT_PUBLIC_ENABLE_VOICE_INPUT=true
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_LOCAL_STORAGE=true

# NLP Settings
NLP_CONFIDENCE_THRESHOLD=0.5
NLP_LANGUAGE="he-IL"

# Supabase Configuration
# Get these from: https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Claude AI - LifeBalance Assistant
# Get API key from: https://console.anthropic.com/account/keys
ANTHROPIC_API_KEY=your_api_key_here

# Note: For production, store secrets in environment variables only!
# Never commit .env.local to version control
