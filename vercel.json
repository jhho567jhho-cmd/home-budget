{
  "name": "nlp-coach",
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "public": false,
  "env": [
    {
      "key": "NEXT_PUBLIC_APP_NAME",
      "value": "NLP Coach"
    }
  ],
  "functions": {
    "api/**/*.ts": {
      "memory": 1024,
      "maxDuration": 60
    }
  }
}
